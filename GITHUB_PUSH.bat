@echo off
chcp 65001 > nul
title GitHub アップロード (GitHub Pages 公開用)
cd /d "%~dp0"

echo ========================================================================
echo  💊 医薬品890品目 添付文書実務パッケージ GitHub アップロードツール
echo ========================================================================
echo.
echo GitHub で作成したリポジトリの URL を入力してください。
echo （例: https://github.com/your-name/pharma-890.git）
echo.
set /p REPO_URL="リポジトリURL: "

if "%REPO_URL%"=="" (
    echo [エラー] URLが入力されませんでした。処理を中断します。
    pause
    exit /b
)

echo.
echo ------------------------------------------------------------------------
echo 1. Git リポジトリを初期化しています...
echo ------------------------------------------------------------------------
if not exist ".git" (
    git init
)

echo ------------------------------------------------------------------------
echo 2. ファイルをステージングしています（524MBのため少々お待ちください）...
echo ------------------------------------------------------------------------
git add .

echo ------------------------------------------------------------------------
echo 3. コミットを作成しています...
echo ------------------------------------------------------------------------
git commit -m "Deploy: 医薬品890品目 添付文書実務パッケージ (パスワード認証付き)"

echo ------------------------------------------------------------------------
echo 4. ブランチを main に設定しています...
echo ------------------------------------------------------------------------
git branch -M main

echo ------------------------------------------------------------------------
echo 5. リモートリポジトリを設定しています...
echo ------------------------------------------------------------------------
git remote remove origin 2>nul
git remote add origin %REPO_URL%

echo ------------------------------------------------------------------------
echo 6. GitHub へ push しています（初回アップロード）...
echo ------------------------------------------------------------------------
git push -u origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ========================================================================
    echo  🎉 アップロードが正常に完了しました！
    echo ========================================================================
    echo.
    echo 次の手順：
    echo 1. GitHub のリポジトリ画面で [Settings] -^> [Pages] を開きます。
    echo 2. Branch を「main」に設定して「Save」を押します。
    echo 3. 数分後に Web サイトが公開され、パスワード [ 377011 ] で保護されます！
    echo.
) else (
    echo.
    echo [エラー] アップロードに失敗しました。
    echo GitHub へのログイン認証情報またはリポジトリURLをご確認ください。
    echo.
)

pause
